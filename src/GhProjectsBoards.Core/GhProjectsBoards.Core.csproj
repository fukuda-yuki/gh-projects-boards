<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The app acquires the Copilot runtime; Core only needs the SDK API. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Planning/JapanHolidays2025-2027.json" />
    <InternalsVisibleTo Include="GhProjectsBoards.App" />
    <InternalsVisibleTo Include="GhProjectsBoards.UiIntegration.Tests" />
    <InternalsVisibleTo Include="GhProjectsBoards.Tests" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="[1.0.22]" />
  </ItemGroup>
</Project>
