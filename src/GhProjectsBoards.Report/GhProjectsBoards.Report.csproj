<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ghpb-report</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Core only needs the Copilot SDK API; this tool never starts the runtime. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GhProjectsBoards.Core/GhProjectsBoards.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The demo's waterfall shapes are the tracked evaluation versions, so the demo and the tests agree on one plan. -->
    <EmbeddedResource Include="../../evaluation/version-plan.json" LogicalName="GhProjectsBoards.Report.version-plan.json" />
    <EmbeddedResource Include="../../evaluation/version-plan-12m.json" LogicalName="GhProjectsBoards.Report.version-plan-12m.json" />
  </ItemGroup>
</Project>
