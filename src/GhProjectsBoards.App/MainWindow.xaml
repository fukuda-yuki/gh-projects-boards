<Window
    x:Class="GhProjectsBoards.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhProjectsBoards.App"
    Title="GitHub Projects Boards">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="GlobalNavigation" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,4" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="GitHub Projects Boards" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="WorkspaceTab" Content="ワークスペース" MinHeight="28" Padding="10,4" Click="ShowProjects" AutomationProperties.AutomationId="ProjectsPageButton"/>
                    <Button x:Name="ConnectionTab" Content="接続設定" MinHeight="28" Padding="10,4" Click="ShowConnection" AutomationProperties.AutomationId="ConnectionPageButton"/>
                </StackPanel>
            </Grid>
        </Border>
    <ScrollViewer x:Name="ConnectionPage" Grid.Row="1" AutomationProperties.AutomationId="ConnectionScreen"
                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel Margin="28" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="GitHub 接続" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="接続先と権限を確認します。この画面から Issue や Project は更新されません。"
                       TextWrapping="Wrap" />
            <TextBox x:Name="ExecutableInput" Header="GitHub CLI 実行ファイル"
                     AutomationProperties.AutomationId="ExecutablePath" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DetectButton" Content="自動検出" Click="Detect_Click"
                        AutomationProperties.AutomationId="DetectGhButton" />
                <Button x:Name="BrowseButton" Content="参照…" Click="Browse_Click"
                        AutomationProperties.AutomationId="BrowseGhButton" />
            </StackPanel>
            <TextBox x:Name="HostInput" Header="GitHub ホスト" AutomationProperties.AutomationId="HostInput" />
            <TextBox x:Name="IssueInput" Header="Issue URL（任意）" AutomationProperties.AutomationId="IssueUrlInput" />
            <TextBox x:Name="ProjectInput" Header="Project URL（任意）" AutomationProperties.AutomationId="ProjectUrlInput" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckButton" Content="接続を確認 / 再確認" Click="Check_Click"
                        AutomationProperties.AutomationId="CheckConnectionButton" />
                <Button x:Name="SwitchButton" Content="新しい接続として確認" Click="Switch_Click"
                        AutomationProperties.AutomationId="NewConnectionButton" />
                <Button x:Name="CancelButton" Content="キャンセル" Click="Cancel_Click"
                        AutomationProperties.AutomationId="CancelConnectionButton" />
            </StackPanel>
            <TextBlock x:Name="StatusValue" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatus" />
            <TextBlock x:Name="UiMessage" TextWrapping="Wrap" AutomationProperties.AutomationId="UiMessage" />
            <TextBlock x:Name="EnvironmentValue" TextWrapping="Wrap" AutomationProperties.AutomationId="EnvironmentValue" />
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="CLI バージョン" />
                <TextBlock x:Name="VersionValue" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="VersionValue" />
                <TextBlock Text="アカウント" Grid.Row="1" />
                <TextBlock x:Name="AccountValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="AccountValue" />
                <TextBlock Text="資格情報の保存先" Grid.Row="2" />
                <TextBlock x:Name="StorageValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageValue" />
                <TextBlock Text="スコープ" Grid.Row="3" />
                <TextBlock x:Name="ScopeValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="ScopeValue" />
                <TextBlock Text="Issue" Grid.Row="4" />
                <TextBlock x:Name="IssueValue" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="IssueResult" />
                <TextBlock Text="Project" Grid.Row="5" />
                <TextBlock x:Name="ProjectValue" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="ProjectResult" />
            </Grid>
            <Expander Header="ログイン・権限追加の手順" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="LoginHelpExpander">
                <StackPanel Spacing="10">
                    <TextBlock Text="コマンドをコピーし、ご自身の PowerShell で実行してから再確認してください。"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="LoginCommandValue" IsReadOnly="True" TextWrapping="Wrap" Header="ログイン"
                             AutomationProperties.AutomationId="LoginCommand" />
                    <Button Content="ログインコマンドをコピー" Click="CopyLogin_Click" AutomationProperties.AutomationId="CopyLoginButton" />
                    <TextBox x:Name="RefreshCommandValue" IsReadOnly="True" TextWrapping="Wrap" Header="権限追加"
                             AutomationProperties.AutomationId="RefreshCommand" />
                    <Button Content="権限追加コマンドをコピー" Click="CopyRefresh_Click" AutomationProperties.AutomationId="CopyRefreshButton" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
        <local:RegistrationPanel x:Name="ProjectsPage" Grid.Row="1"/>
    </Grid>
</Window>
