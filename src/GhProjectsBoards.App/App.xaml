<Application
    x:Class="GhProjectsBoards.App.App"
    RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:GhProjectsBoards.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WorkspaceCardStrokeBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="SheetSelectionLineBrush" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="UnpublishedBadgeTextBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SheetSeparatorBrush" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="SheetSelectionBrush" Color="#EBF3FC"/>
                    <SolidColorBrush x:Key="SheetSelectionStrokeBrush" Color="{ThemeResource SystemAccentColorDark1}"/>
                    <SolidColorBrush x:Key="SheetChangedBrush" Color="#FFF8E5"/>
                    <SolidColorBrush x:Key="SheetChangedMarkBrush" Color="#9D5D00"/>
                    <SolidColorBrush x:Key="GanttTaskBrush" Color="#2266C2"/>
                    <SolidColorBrush x:Key="GanttTaskTintBrush" Color="#D6E5F7"/>
                    <SolidColorBrush x:Key="GanttSummaryBrush" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="GanttArrowBrush" Color="#8A8A8A"/>
                    <SolidColorBrush x:Key="GanttNonWorkingBrush" Color="#F7F7F7"/>
                    <SolidColorBrush x:Key="GanttLateBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="GanttLateTintBrush" Color="#FDE7E9"/>
                    <SolidColorBrush x:Key="IndicatorDoneBrush" Color="#0F7B0F"/>
                    <SolidColorBrush x:Key="IndicatorTypedBrush" Color="#616161"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="WorkspaceCardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="WorkspaceCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SheetSelectionLineBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="UnpublishedBadgeTextBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetSeparatorBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetSelectionBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetSelectionStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SheetChangedBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetChangedMarkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="GanttTaskBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="GanttTaskTintBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="GanttSummaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="GanttArrowBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="GanttNonWorkingBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="GanttLateBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="GanttLateTintBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="IndicatorDoneBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="IndicatorTypedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ItemsPanelTemplate x:Key="PlanSheetRowsPanel"><ItemsStackPanel CacheLength="0"/></ItemsPanelTemplate>
            <DataTemplate x:Key="PlanSheetRowTemplate"><local:PlanSheetRow /></DataTemplate>
            <DataTemplate x:Key="PlanPublishGroupTemplate"><local:PlanPublishGroupView /></DataTemplate>
            <DataTemplate x:Key="PlanProjectChoiceTemplate">
                <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Url}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Opacity="0" IsHitTestVisible="False" IsTabStop="False" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding OwnerLogin}"/><Run Text=" · Project "/><Run Text="{Binding Number}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="WorkspaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkspaceCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceCardStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="12"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>
            <Style x:Key="WorkspaceMetadataStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="WorkspaceErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Style>
            <Style x:Key="PlanWorkspaceSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource WorkspaceBackgroundBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
