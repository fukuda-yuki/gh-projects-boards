<Application
    x:Class="GhProjectsBoards.App.App"
    RequestedTheme="Dark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:GhProjectsBoards.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SheetChangedBrush" Color="#FFF5DB"/>
                    <SolidColorBrush x:Key="SheetSelectionBrush" Color="#E6F0FA"/>
                    <SolidColorBrush x:Key="SheetSelectionStrokeBrush" Color="{ThemeResource SystemAccentColorDark1}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SheetChangedBrush" Color="#3D3525"/>
                    <SolidColorBrush x:Key="SheetSelectionBrush" Color="#253D52"/>
                    <SolidColorBrush x:Key="SheetSelectionStrokeBrush" Color="{ThemeResource SystemAccentColorLight2}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SheetChangedBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetSelectionBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SheetSelectionStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ItemsPanelTemplate x:Key="PlanSheetRowsPanel"><ItemsStackPanel CacheLength="0"/></ItemsPanelTemplate>
            <DataTemplate x:Key="PlanSheetRowTemplate"><local:PlanSheetRow /></DataTemplate>
            <DataTemplate x:Key="PlanProjectChoiceTemplate">
                <StackPanel Spacing="2" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{Binding Url}">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding OwnerLogin}"/><Run Text=" #"/><Run Text="{Binding Number}"/>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="PlanWorkspaceSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
