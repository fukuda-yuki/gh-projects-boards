<UserControl
    x:Class="GhProjectsBoards.App.RegistrationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhProjectsBoards.App"
    SizeChanged="PanelSizeChanged">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="8,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="NavigationToggle" MinHeight="28" Padding="8,4" Click="ToggleNavigation" ToolTipService.ToolTip="Project一覧を表示 / 非表示"
                        AutomationProperties.AutomationId="ToggleProjectNavigation" AutomationProperties.Name="Project一覧を折りたたむ">
                    <SymbolIcon Symbol="GlobalNavigationButton"/>
                </Button>
                <TextBlock x:Name="Identity" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="WorkspaceIdentity"/>
                <Button x:Name="Cancel" Grid.Column="2" Content="処理をキャンセル" MinHeight="28" Padding="10,4" Click="CancelWork" AutomationProperties.AutomationId="CancelProjectButton"/>
                <Button x:Name="ConnectionSettings" Grid.Column="3" Content="接続設定" MinHeight="28" Padding="10,4" Click="RequestConnection" AutomationProperties.AutomationId="ConnectionPageButton"/>
                <HyperlinkButton Grid.Column="4" Content="マニュアル" MinHeight="28" Padding="8,4"
                                 NavigateUri="https://github.com/fukuda-yuki/gh-projects-boards/blob/main/docs/user-manual.md"
                                 AutomationProperties.AutomationId="UserManualButton"/>
            </Grid>
        </Border>
        <SplitView x:Name="WorkspaceSplitView" Grid.Row="1" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="212" CompactPaneLength="0">
            <SplitView.Pane>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                    <Grid Padding="8,12,8,8" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <local:FormComboBox x:Name="Profiles" Header="保存済みアカウント" PlaceholderText="アカウントを選択" HorizontalAlignment="Stretch"
                                  SelectionChanged="ProfileChanged" AutomationProperties.AutomationId="SavedProfiles"/>
                        <TextBlock x:Name="NavigationHeading" Grid.Row="1" Text="Project" FontWeight="SemiBold" Margin="8,0"/>
                        <StackPanel x:Name="NavigationFilterPanel" Grid.Row="2" Spacing="4">
                            <local:FormComboBox x:Name="NavigationRepository" Header="関連Repositoryで探す" HorizontalAlignment="Stretch"
                                      SelectionChanged="NavigationRepositoryChanged" AutomationProperties.AutomationId="NavigationRepositoryFilter"/>
                            <Button x:Name="ClearNavigationRepository" Content="絞り込みを解除" Click="ClearNavigationRepositoryFilter"
                                    MinHeight="28" Padding="8,4" Visibility="Collapsed" AutomationProperties.AutomationId="ClearNavigationRepositoryFilter"/>
                            <TextBlock x:Name="NavigationFilterNotice" TextWrapping="Wrap" Visibility="Collapsed"
                                       AutomationProperties.AutomationId="NavigationFilterNotice" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <TreeView x:Name="Navigation" Grid.Row="3" ItemInvoked="Navigate" SelectionMode="Single" AutomationProperties.AutomationId="ProjectNavigation"/>
                        <StackPanel Grid.Row="4" Spacing="4">
                            <Button x:Name="Add" Content="Projectを追加…" HorizontalAlignment="Stretch" Click="ShowAdd" AutomationProperties.AutomationId="AddProjectButton"/>
                            <Button x:Name="StartGuide" Content="作業を始める" HorizontalAlignment="Stretch" Click="ShowGettingStarted" AutomationProperties.AutomationId="StartGuideButton"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>
            <Grid>
                <ScrollViewer x:Name="DiscoveryForm" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Padding="20,16" MaxWidth="760" HorizontalAlignment="Left">
                        <Button x:Name="DiscoveryBack" Content="ワークスペースへ戻る" Click="BackToPreview" AutomationProperties.AutomationId="CloseProjectDiscoveryButton"/>
                        <TextBlock Text="Projectを追加" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="DiscoveryConnectionHint" Text="接続が必要です。接続設定を確認して、この登録作業へ戻ってください。" TextWrapping="Wrap"/>
                        <Button x:Name="DiscoveryConnection" Content="接続設定" Click="RequestConnection" AutomationProperties.AutomationId="RegistrationConnectionSettings"/>
                        <TextBox x:Name="Url" Header="Project URL" AutomationProperties.AutomationId="RegistrationUrl"/>
                        <Button Content="URLを確認" Click="ResolveUrl" AutomationProperties.AutomationId="ResolveProjectButton"/>
                        <Expander Header="所有者・Repositoryから探す" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProjectDiscoverySearchExpander">
                            <StackPanel Spacing="12">
                                <local:FormComboBox x:Name="Owners" Header="接続アカウントの所有者候補" HorizontalAlignment="Stretch" SelectionChanged="OwnerSelected" AutomationProperties.AutomationId="DiscoveryOwners"/>
                                <Button Content="所有者候補を取得" Click="LoadOwners" AutomationProperties.AutomationId="LoadOwnersButton"/>
                                <TextBox x:Name="Owner" Header="所有者・Organization（直接入力も可）" AutomationProperties.AutomationId="DiscoveryOwner"/>
                                <Button Content="所有者のRepositoryを取得" Click="LoadRepositories" AutomationProperties.AutomationId="LoadRepositoriesButton"/>
                                <local:FormComboBox x:Name="Repositories" Header="Repository（未選択なら所有者の全Project）" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DiscoveryRepositories"/>
                                <TextBox x:Name="Search" Header="Project検索語（任意）" AutomationProperties.AutomationId="DiscoverySearch"/>
                                <Button Content="Projectを検索" Click="SearchProjects" AutomationProperties.AutomationId="SearchProjectsButton"/>
                            </StackPanel>
                        </Expander>
                        <ListView x:Name="Candidates" MaxHeight="144" SelectionChanged="CandidateSelected" AutomationProperties.AutomationId="ProjectCandidates"/>
                        <TextBlock x:Name="Confirmation" TextWrapping="Wrap" AutomationProperties.AutomationId="ProjectConfirmation"/>
                        <TextBox x:Name="InitialRepository" Header="新しいローカル行の既定Repository（任意、owner/repo）" AutomationProperties.AutomationId="InitialDefaultRepository"/>
                        <Button x:Name="Register" Content="登録" Style="{StaticResource AccentButtonStyle}" Click="RegisterProject" AutomationProperties.AutomationId="RegisterProjectButton"/>
                        <Button Content="対象のアクセス権限を確認…" Click="ShowTargetDiagnostics" AutomationProperties.AutomationId="RegistrationTargetDiagnostics"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="Preview">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid x:Name="ProjectHeader" Padding="8,0" RowSpacing="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid x:Name="ProjectIdentityContext" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed" AutomationProperties.AutomationId="ProjectIdentityContext">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="ProjectIdentityButton" MinHeight="24" Padding="4,0" MaxWidth="420"
                                        AutomationProperties.AutomationId="ProjectIdentityButton" ToolTipService.ToolTip="ProjectのURLを確認・コピー">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel MaxWidth="480" Spacing="8">
                                                <TextBox x:Name="ProjectIdentityUrl" Header="Project URL" IsReadOnly="True" TextWrapping="Wrap"
                                                         AutomationProperties.AutomationId="ProjectIdentityUrl"/>
                                                <Button Content="URLをコピー" Click="CopyProjectUrl" AutomationProperties.AutomationId="CopyProjectUrlButton"/>
                                                <TextBlock x:Name="ProjectIdentityCopyStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock x:Name="ProjectContext" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ProjectCacheDestination"/>
                            </Grid>
                            <CommandBar x:Name="ProjectCommands" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProjectCommandBar">
                                <CommandBar.Content>
                                    <TextBlock x:Name="Summary" MaxWidth="240" Margin="4,0,12,0" VerticalAlignment="Center"
                                               Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ProjectSummary"/>
                                </CommandBar.Content>
                                <AppBarButton x:Name="Apply" Label="GitHubに反映…" Icon="Upload" Click="ReviewApply" AutomationProperties.AutomationId="ReviewApplyButton"/>
                                <AppBarButton x:Name="Refresh" Label="最新を取得" Icon="Refresh" Click="RefreshProject" AutomationProperties.AutomationId="RefreshProjectButton"/>
                                <AppBarButton x:Name="WeeklyApply" Label="週次反映…" Icon="Upload" Click="ReviewWeeklyApply" ToolTipService.ToolTip="表示行の実績・残工数を選択して確認" AutomationProperties.AutomationId="ReviewWeeklyApplyButton"/>
                                <AppBarButton x:Name="ApplyHistory" Label="反映履歴" Icon="Clock" Click="ShowApplyHistory" AutomationProperties.AutomationId="ApplyHistoryButton"/>
                                <AppBarButton x:Name="PlanningSettingsCommand" Label="計画の前提" Icon="Calendar" Click="ShowPlanningSettings" AutomationProperties.AutomationId="ProjectPlanningSettings"/>
                                <AppBarButton x:Name="ProjectSettings" Label="Project設定" Icon="Setting" ToolTipService.ToolTip="Project設定" AutomationProperties.Name="Project設定" AutomationProperties.AutomationId="ProjectSettingsButton">
                                    <AppBarButton.Flyout>
                                        <Flyout x:Name="ProjectSettingsFlyout" Placement="BottomEdgeAlignedRight">
                                            <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Width="380" Spacing="12">
                                                    <TextBlock Text="Projectの情報と設定" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                                    <Expander Header="Project情報" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                        <TextBlock x:Name="ProjectInformation" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ProjectInformation"/>
                                                    </Expander>
                                                    <Button Content="対象のアクセス権限を確認…" Click="ShowTargetDiagnostics" AutomationProperties.AutomationId="ProjectTargetDiagnostics"/>
                                                    <Button Content="処理状況・診断…" Click="ShowStatusDetails" AutomationProperties.AutomationId="ProjectStatusDetailsButton"/>
                                                    <TextBox x:Name="DefaultRepository" Header="新規行の既定Repository" PlaceholderText="owner/repo" ToolTipService.ToolTip="今後追加する行の宛先。既存行の宛先や取得範囲は変わりません。" AutomationProperties.AutomationId="DefaultRepository"/>
                                                    <Button x:Name="SaveSetting" Content="設定を保存" Click="SaveDefault" AutomationProperties.AutomationId="SaveProjectSettingButton"/>
                                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                        <Button x:Name="Remove" Content="ローカル登録を解除…" Click="RemoveProject" AutomationProperties.AutomationId="UnregisterProjectButton"/>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Flyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar>
                        </Grid>
                    </Border>
                    <Grid x:Name="EditorHost" Grid.Row="1"/>
                    <InfoBar x:Name="PartialNotice" Grid.Row="2" Severity="Warning" IsOpen="False" IsClosable="False"
                             Title="一部取得・未採用観測" Message="下の観測は保存キャッシュ・下書きとは別です。未取得範囲は不明で、取得結果全体を保存した状態ではありません。"
                             AutomationProperties.AutomationId="IncompleteObservationNotice"/>
                    <StackPanel x:Name="EmptyWorkspace" Grid.Row="1" Spacing="12" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <SymbolIcon Symbol="List" Width="40" Height="40"/>
                        <TextBlock x:Name="EmptyTitle" Text="Projectを開く" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="EmptyNextAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                                Click="ContinueGettingStarted" AutomationProperties.AutomationId="EmptyWorkspaceAction"/>
                    </StackPanel>
                    <ListView x:Name="Items" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProjectItems">
                        <ListView.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind Mode=OneTime}" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="GettingStarted" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="GettingStartedGuide">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Spacing="12">
                        <SymbolIcon Symbol="List" Width="40" Height="40"/>
                        <TextBlock x:Name="GuideTitle" Text="Projectを開く" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="GuideContext" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="GuideContext"/>
                        <Button x:Name="GuideNextAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                                Click="ContinueGettingStarted" AutomationProperties.AutomationId="GuideNextButton"/>
                        <Button Content="後で" HorizontalAlignment="Center" Click="DismissGettingStarted" AutomationProperties.AutomationId="GuideLaterButton"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </SplitView>
        <Border x:Name="WorkspaceStatusBar" Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.AutomationId="WorkspaceStatusBar">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ProgressBar x:Name="Progress" Grid.ColumnSpan="2" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="Status" Grid.Row="1" Margin="12,4" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="RegistrationStatus"/>
                <Button x:Name="StatusDetailsButton" Grid.Row="1" Grid.Column="1" Content="状況の詳細…" MinHeight="28" Padding="10,4" Margin="4,0,8,0" AutomationProperties.AutomationId="WorkspaceStatusDetailsButton">
                    <Button.Flyout>
                        <Flyout x:Name="StatusDetailsFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel MaxWidth="560" Spacing="12">
                                <TextBlock Text="現在の処理状況" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBox x:Name="StatusDetailsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinWidth="280" MaxWidth="560" MaxHeight="400"
                                         AutomationProperties.AutomationId="WorkspaceStatusDetails" AutomationProperties.Name="現在の処理状況の全文"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <StackPanel x:Name="ApplyProgressPanel" Grid.Row="2" Grid.ColumnSpan="2" Margin="12,4" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="反映中"/>
                    <ListView x:Name="ApplyProgressRows" MaxHeight="100" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ApplyProgressRows">
                        <ListView.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind Mode=OneTime}" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
