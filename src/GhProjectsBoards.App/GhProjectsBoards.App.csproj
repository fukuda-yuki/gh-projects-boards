<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../templates/new-tasks.csv" Link="templates/new-tasks.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/user-manual.md" Link="マニュアル.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/manual/images/*.png" Link="manual/images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="GhProjectsBoards.UiIntegration.Tests" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.5.4-experimental]" />
    <!-- Unused Widgets component assets have different redistribution terms from the Runtime MSIX. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="[2.0.6-experimental]" ExcludeAssets="all" />
    <ProjectReference Include="../GhProjectsBoards.Core/GhProjectsBoards.Core.csproj" />
  </ItemGroup>
</Project>
