<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This assembly supplies the isolated fake gh used by adapter and desktop tests. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/JapanHolidays.csv" />
    <EmbeddedResource Include="Fixtures/Phase9Snapshot2.json" />
    <EmbeddedResource Include="../../evaluation/version-plan.json" LogicalName="VersionPlan-2027.04.json" />
    <EmbeddedResource Include="../../evaluation/version-plan-12m.json" LogicalName="VersionPlan-2027.10.json" />
    <InternalsVisibleTo Include="GhProjectsBoards.UiIntegration.Tests" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.6.1" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" PrivateAssets="all" />
    <ProjectReference Include="../../src/GhProjectsBoards.Core/GhProjectsBoards.Core.csproj" />
  </ItemGroup>
</Project>
