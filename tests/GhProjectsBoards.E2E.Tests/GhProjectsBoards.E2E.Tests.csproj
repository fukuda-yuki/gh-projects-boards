<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.6.1" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- E2E drives the ordinary executable; these references only build its prerequisites. -->
    <ProjectReference Include="../../src/GhProjectsBoards.App/GhProjectsBoards.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../GhProjectsBoards.Tests/GhProjectsBoards.Tests.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
