  "calc_js": "\"use strict\";\n\n// Delegation target for the bridge's end-to-end check. Both `add` and\n// `multiply` are implemented in this scratch copy; the tracked source under\n// demo/ is copied in before each delegated run.\nfunction add(a, b) {\n  return a + b;\n}\n\n// `Number.isFinite` deliberately does not coerce, so a numeric string, NaN and\n// the infinities are rejected instead of silently producing a numeric result.\nfunction multiply(a, b) {\n  if (!Number.isFinite(a) || !Number.isFinite(b)) {\n    throw new TypeError(\"multiply requires finite numbers\");\n  }\n  return a * b;\n}\n\nmodule.exports = { add, multiply };\n",
  "check_js": "\"use strict\";\n\n// Verification the delegated run must make pass with `node demo/check.js`.\n// Exit code 0 means every case passed; 1 prints the failing case and exits.\nconst { add, multiply } = require(\"./calc.js\");\n\n// The rejection cases assert the error type, so they pass only on a TypeError\n// and fail both when nothing is thrown and when the wrong error type is thrown.\nconst throwsTypeError = (call) => () => {\n  try {\n    call();\n    return false;\n  } catch (error) {\n    return error instanceof TypeError;\n  }\n};\n\nconst cases = [\n  [\"add keeps working\", () => add(2, 3) === 5],\n  [\"multiply(6, 7) === 42\", () => multiply(6, 7) === 42],\n  [\"multiply(-3, 4) === -12\", () => multiply(-3, 4) === -12],\n  [\"multiply('x', 2) throws TypeError\", throwsTypeError(() => multiply(\"x\", 2))],\n  [\"multiply(NaN, 2) throws TypeError\", throwsTypeError(() => multiply(NaN, 2))],\n  [\"multiply(Infinity, 2) throws TypeError\", throwsTypeError(() => multiply(Infinity, 2))],\n];\n\nlet failed = 0;\nfor (const [name, run] of cases) {\n  let ok = false;\n  let detail = \"\";\n  try {\n    ok = run() === true;\n  } catch (error) {\n    detail = ` (${error.message})`;\n  }\n  if (!ok) failed += 1;\n  console.log(`${ok ? \"PASS\" : \"FAIL\"} ${name}${detail}`);\n}\n\nif (failed > 0) {\n  console.log(`FAILED ${failed}/${cases.length}`);\n  process.exit(1);\n}\nconsole.log(`PASSED ${cases.length}/${cases.length}`);\n"
}
